---
const { items = [] } = Astro.props;
---
{items.length ? (
  <nav class="topnav">
    <div class="topnav-inner">
      {items.map((it: { label: string; href: string }) => (
        <a class="navbtn" href={it.href} data-spy={it.href.replace('#', '')}>{it.label}</a>
      ))}
    </div>
  </nav>
) : null}
