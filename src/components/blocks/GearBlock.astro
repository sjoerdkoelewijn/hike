---
const { block } = Astro.props;
const items = block?.items ?? [];
---
<section class="card" id={block._anchor}>
  {block.title && <h2>{block.title}</h2>}
  {block.intro && <p>{block.intro}</p>}
  {items.length ? (
    <div class="gear">
      {items.map((it: { name?: string; note?: string; url?: string }) => (
        <div class="gear-item">
          {it.url ? (
            <a class="gear-name gear-link" href={it.url} target="_blank" rel="noopener">
              {it.name}
              <svg
                class="ext-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true" focusable="false"
              >
                <path d="M9.5 2.5h4v4" />
                <path d="M13.5 2.5 7.5 8.5" />
                <path d="M12 9.5v2.75a1.25 1.25 0 0 1-1.25 1.25h-7A1.25 1.25 0 0 1 2.5 12.25v-7A1.25 1.25 0 0 1 3.75 4H6.5" />
              </svg>
            </a>
          ) : (
            <div class="gear-name">{it.name}</div>
          )}
          {it.note && <p class="gear-note">{it.note}</p>}
        </div>
      ))}
    </div>
  ) : null}
</section>
