---
const { block } = Astro.props;
const stats = block?.stats ?? [];
const etappes = block?.etappes ?? [];
---
<section class="card" id={block._anchor}>
  {block.title && <h2>{block.title}</h2>}
  {block.intro && <p>{block.intro}</p>}
  {stats.length ? (
    <div class="route-stats">
      {stats.map((s: { value: string; label: string }) => (
        <div class="stat"><span class="val">{s.value}</span><span class="lab">{s.label}</span></div>
      ))}
    </div>
  ) : null}
  {etappes.length ? (
    <div class="etappes">
      {etappes.map((e: { day: string; meta: string; url?: string }) => (
        <div class="etappe">
          {e.url ? (
            <a class="day day-link" href={e.url} target="_blank" rel="noopener">
              {e.day}
              <svg
                class="ext-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true" focusable="false"
              >
                <path d="M9.5 2.5h4v4" />
                <path d="M13.5 2.5 7.5 8.5" />
                <path d="M12 9.5v2.75a1.25 1.25 0 0 1-1.25 1.25h-7A1.25 1.25 0 0 1 2.5 12.25v-7A1.25 1.25 0 0 1 3.75 4H6.5" />
              </svg>
            </a>
          ) : (
            <span class="day">{e.day}</span>
          )}
          <span class="meta">{e.meta}</span>
        </div>
      ))}
    </div>
  ) : null}
  {block.alltrailsUrl && (
    <a class="route-link" style="margin-top:1.4rem" href={block.alltrailsUrl} target="_blank" rel="noopener">
      {block.alltrailsLabel || 'Open op AllTrails →'}
    </a>
  )}
</section>
