---
const { hero } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: unknown) => (p ? `${base}/${String(p).replace(/^\//, '')}` : '');
const img = url(hero?.image);
// Optioneel: een bredere uitsnede voor desktop. Een staande of vierkante foto
// wordt op een breed scherm namelijk grotendeels weggesneden door `cover`.
const imgWide = url(hero?.imageWide);
const style = [
  `--hero-image: url('${img}')`,
  imgWide && `--hero-image-wide: url('${imgWide}')`,
].filter(Boolean).join('; ');
---
<header class="hero" style={style}>
  {hero?.kicker && <p class="kicker">{hero.kicker}</p>}
  <h1>{hero?.title}</h1>
  {hero?.subtitle && <p class="subtitle">{hero.subtitle}</p>}
  {hero?.chips?.length ? (
    <div class="chips">
      {hero.chips.map((c: string) => <span class="chip">{c}</span>)}
    </div>
  ) : null}
</header>
