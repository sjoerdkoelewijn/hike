# Kopieer dit bestand naar .env en vul de waarden in.
# .env staat in .gitignore en komt dus NOOIT in de repo.

SITE_URL=https://sjoerdkoelewijn.github.io

# Publieke Client ID van je Tina Cloud project (mag openbaar zijn)
TINA_PUBLIC_CLIENT_ID=

# Geheime Read-Only Token van je Tina Cloud project (NOOIT delen of committen)
TINA_TOKEN=
